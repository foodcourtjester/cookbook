{
  "id": "dark-chocolate-ganache-tart",
  "title": "Dark Chocolate Ganache Tart",
  "categories": ["desserts"],
  "img": "images/dark-chocolate-ganache-tart.jpg",
  "equipment": [
    "Sauce pan",
    "Medium mixing bowl",
    "Plastic Wrap",
    "Spatula"
  ],
  "ingredients": [
    "12 oz. dark chocolate chips",
    "1 cup heavy cream",
    "1 Tbsp unsalted butter, softened to room temperature",
    "1 graham cracker crust",
    "Sea salt for serving"
  ],
  "instructions": [
    "Place chocolate chips and butter in a medium-sized mixing bowl.",
    "In a small sauce pan, bring the heavy cream to a slight simmer.",
    "Pour the cream over the chocolate chips and butter and cover immediately with plastic wrap.",
    "Let the covered mixture sit for about 5 minutes.",
    "Stir the mixture until a smooth and consistent thick liquid has formed, about 6-7 minutes.",
    "If there are still chunks of chocolate, warm again using a double boiler or on low power in a microwave oven .",
    "Pour into the graham cracker crust and allow to cool in the refrigerator.",
    "Sprinkle with sea salt and serve."
  ]
}
